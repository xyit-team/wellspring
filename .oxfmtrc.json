{
    "$schema": "./node_modules/oxfmt/configuration_schema.json",
    "printWidth": 100,
    "tabWidth": 4,
    "semi": false,
    "singleQuote": false,
    "trailingComma": "all",
    "endOfLine": "lf",
    "ignorePatterns": ["pnpm-lock.yaml"],
    "overrides": [
        {
            "files": ["**/*.{json,jsonc,yml,yaml,md}"],
            "options": { "tabWidth": 4 }
        }
    ]
}

{
    "logger": {
        "level": "info"
    },
    "openai": {
        "baseUrl": null,
        "model": "gpt-4o-mini",
        "timeoutMs": 60000,
        "maxRetries": 2
    },
    "network": {
        "proxy": {
            "type": "http",
            "url": "http://127.0.0.1:7890",
            "noProxy": ["localhost", "127.0.0.1"]
        }
    },
    "sandbox": {
        "mode": "strict",
        "backend": "auto",
        "maxConcurrent": 2,
        "defaultTimeoutMs": 60000,
        "defaultMemoryMB": 512,
        "outputLimitBytes": 16777216
    },
    "plugins": {
        "update": {
            "type": "npm",
            "registry": "https://registry.npmjs.org",
            "githubToken": null
        }
    }
}

{
    "name": "@xyit/wellspring",
    "version": "1.7.0",
    "description": "Wellspring 源泉 —— 插件式 Agent 平台与 CLI（Plugin-based AI agent platform and CLI）",
    "keywords": [
        "agent",
        "ai",
        "cli",
        "llm",
        "plugin",
        "wellspring"
    ],
    "license": "MIT",
    "author": "xyit-team",
    "repository": {
        "type": "git",
        "url": "https://github.com/xyit-team/wellspring.git"
    },
    "bin": {
        "wellspring": "./dist/index.js"
    },
    "files": [
        "dist",
        "src",
        "scripts",
        "bin",
        "README.md",
        "LICENSE"
    ],
    "type": "module",
    "main": "dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js"
        },
        "./api/host": {
            "types": "./dist/api/host/index.d.ts",
            "import": "./dist/api/host/index.js"
        },
        "./package.json": "./package.json"
    },
    "publishConfig": {
        "access": "public"
    },
    "scripts": {
        "start": "node src/index.ts",
        "test": "node scripts/run-tests.mjs",
        "typecheck": "tsc --noEmit",
        "format": "oxfmt",
        "format:check": "oxfmt --check",
        "pty:build": "node scripts/build-node-pty.mjs",
        "build": "tsc -p tsconfig.build.json && node scripts/rewrite-dts.mjs",
        "prepack": "npm run build",
        "seatbelt:build": "node scripts/build-seatbelt.mjs",
        "win-sandbox:build": "node scripts/build-win-sandbox.mjs"
    },
    "dependencies": {
        "cli-highlight": "^2.1.11",
        "markdansi": "^0.3.6",
        "openai": "^7.39.0",
        "pino": "^10.4.0",
        "undici": "^8.12.3",
        "ws": "^8.18.0"
    },
    "devDependencies": {
        "@types/node": "^26.6.5",
        "@types/ws": "^8.5.0",
        "oxfmt": "^0.73.0",
        "typescript": "^7.0.2"
    },
    "optionalDependencies": {
        "node-pty": "^1.0.0"
    },
    "engines": {
        "node": ">=24"
    }
}

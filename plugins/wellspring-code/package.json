{
    "name": "wellspring-code",
    "version": "1.18.2",
    "packageManager": "npm@11.20.0",
    "description": "浏览器里的 VS Code 风格代码编辑器",
    "type": "module",
    "main": "index.ts",
    "wellspring": {
        "apiVersion": 1,
        "sandbox": {
            "profile": "plugin",
            "fs": {
                "read": [
                    "${pluginDir}",
                    "${workspace}"
                ],
                "write": [
                    "${workspace}"
                ]
            },
            "hostApi": [
                "logger",
                "fs",
                "event",
                "getHost",
                "exec",
                "pty",
                "fileRoots",
                "agent"
            ]
        }
    }
}
